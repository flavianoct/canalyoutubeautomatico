# Copie para .env (uso local). No GitHub Actions, cadastre como "secrets" do repositório.

# Obrigatório: roteiros (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Imagens: OpenAI dá a melhor qualidade. Sem ela, usa o Pollinations (gratuito).
OPENAI_API_KEY=
POLLINATIONS_TOKEN=

# Voz premium opcional (voice.provider: elevenlabs no config.yaml)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# YouTube (gerados pelo comando `python -m kidschannel auth`)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
